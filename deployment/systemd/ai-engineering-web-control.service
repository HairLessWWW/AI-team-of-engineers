[Unit]
Description=AI Team of Engineers Web Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-team-of-engineers
EnvironmentFile=/etc/ai-team-of-engineers/web-control.env
ExecStart=/opt/ai-team-of-engineers/.venv/bin/python -m ai_engineering_platform web-control
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
